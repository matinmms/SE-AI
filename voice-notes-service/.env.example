# ============================================================================
# Voice -> Note (v2.2) service.   cp .env.example .env   then fill the ONE required value.
# Everything else (models, prompts, STT chunking, retries, limits) is already preset in the code
# to exactly what TesaNote runs. Do not change model settings unless you know why.
# ============================================================================

# ---- REQUIRED --------------------------------------------------------------
# The AvalAI key (https://avalai.ir). One key serves speech-to-text AND note writing.
AVALAI_API_KEY=

# ---- Recommended for more than one job at a time ---------------------------
# Redis holds the SHARED provider rate-limit / concurrency counters, so many worker processes
# together still respect AvalAI's limits. Without it each process limits only itself.
# REDIS_URL=redis://localhost:6379/0

# ---- Optional ---------------------------------------------------------------
# Where audio, chunks and the SQLite file live. Default: service/data
# VNS_DATA_DIR=/var/lib/voice-notes
# Database. Default is a local SQLite file (fine for one process). Use Postgres for several
# worker processes / machines:
# VNS_DATABASE_URL=postgres://user:password@host:5432/voice_notes
# Django secret (not used for anything public here, but set it in production)
# DJANGO_SECRET_KEY=change-me

# ---- Provider limits (preset; raise ONLY after confirming your AvalAI plan allows it) -----------
# These are the values TesaNote runs with. They are the real ceiling on how many voices can run at
# once -- see docs/SCALING.md before touching them.
# AVALAI_RPM_LIMIT=45
# AVALAI_TPM_LIMIT=450000
# AVALAI_PROVIDER_MAX_CONCURRENCY=4
